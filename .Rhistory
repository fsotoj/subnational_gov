group_modify(~ asignar_colores(.x)) %>%
ungroup()
colores_por_pais
library(dplyr)
# Normaliza una variable por grupo
normalizar <- function(x) {
if (length(unique(x)) == 1) return(rep(1, length(x)))
return((x - min(x)) / (max(x) - min(x)))
}
partidos_indexados <- data %>%
filter(!is.na(head_party_sub)) %>%
mutate(reciente = ifelse(year >= 2000, 1, 0)) %>%
group_by(country_name, head_party_sub) %>%
summarise(
n = n(),
dosmil = sum(reciente),
votos = sum(votes_candidate_winner, na.rm = TRUE),
.groups = "drop"
) %>%
group_by(country_name) %>%
mutate(
n_norm = normalizar(n),
dosmil_norm = normalizar(dosmil),
votos_norm = normalizar(votos),
# Ponderación: ajusta estos pesos según tu criterio
importancia = 0.4 * n_norm + 0.3 * dosmil_norm + 0.3 * votos_norm
) %>%
arrange(country_name, desc(importancia)) %>%
ungroup()
partidos_indexados
partidos_indexados %>% View()
