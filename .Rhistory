library(leaflet)
library(dplyr)
library(purrr)
data <- openxlsx::read.xlsx("../subnational_gov/data/complete_database_edit.xlsx")
dict<- openxlsx::read.xlsx("../subnational_gov/data/dictionary.xlsx") %>% filter(viewable == 1, scope == "subnational")
geom <- sf::st_read("../subnational_gov/data/geom_simple_maps.geojson")
countries <- unique(data$country_name)
variables <- unique(dict$variable)
years <- unique(data$year)
country_sel <- "BRAZIL"
variable_sel <- dict$variable[22]
year_sel <- 2022
var_info <- filter(dict,variable == variable_sel)
palette_vector <- unlist(strsplit(var_info$palette, ","))
type <- var_info$type
geom_filtered <- geom %>%
filter(country_name == country_sel)
data_filtered <- data %>%
filter(country_name == country_sel, year == year_sel)
data_map <- left_join(geom_filtered, data_filtered, by = "country_state_code")
values <- data_map[[variable_sel]]
pal <- get_leaflet_palette(type,palette_vector, values)
print(paste(country_sel,variable_sel,year_sel))
leaflet(geom_filtered) %>%
#  addTiles() %>%
addPolygons(
fillColor = colors,
color = "black",
weight = 1,
fillOpacity = 0.7
# ,
# label = ~paste0(state_name, ": ", variable_sel)
) %>%
addLegend(
pal = pal$pal,
values = values,
title = variable_sel,
labFormat = function(type, cuts, p) { pal$legend },
position = "bottomright"
)
if (type == "discrete" || type == "continuous") {
