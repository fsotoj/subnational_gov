asignar_colores <- function(df, n_top = 10) {
df <- df %>% arrange(desc(importancia))
n_total <- nrow(df)
n_sec <- max(0, n_total - n_top)
# Colores para fondo negro
colores_top <- qualitative_hcl(n_top, h = seq(15, 375, length.out = n_top + 1)[-1],
c = 80, l = 75)  # saturados, claros
colores_sec <- qualitative_hcl(n_sec, h = seq(15, 375, length.out = n_sec + 1)[-1],
c = 40, l = 85)  # menos saturados, más claros
df$color <- c(colores_top, colores_sec)
return(df)
}
