# Simulamos un dataset
set.seed(123)
data <- expand.grid(
country_name = c("USA", "Canada", "Mexico"),
state_name = c("California", "Texas", "Ontario", "Quebec", "Yucatan", "Jalisco"),
year = 2000:2010
) %>%
filter(
(country_name == "USA" & state_name %in% c("California", "Texas")) |
(country_name == "Canada" & state_name %in% c("Ontario", "Quebec")) |
(country_name == "Mexico" & state_name %in% c("Yucatan", "Jalisco"))
) %>%
mutate(my_variable = runif(n(), 50, 100))
# Estados a comparar (como si vinieran de un input)
selected_states <- c("California", "Ontario", "Jalisco")
# Filtrar
filtered <- data %>%
filter(state_name %in% selected_states)
# Crear el gráfico interactivo
p <- plot_ly()
for (estado in unique(filtered$state_name)) {
df_estado <- filtered %>% filter(state_name == estado)
country <- unique(df_estado$country_name)
p <- add_trace(p,
x = df_estado$year,
y = df_estado$my_variable,
type = "scatter", mode = "lines+markers",
name = paste0(estado, " (", country, ")")
)
}
p <- layout(p,
title = "Evolución por Estado",
xaxis = list(title = "Año"),
yaxis = list(title = "Valor de la variable"),
hovermode = "closest"
)
# Mostrar el gráfico
p
