# Construye una serie anual por cámara, conservando:
# - Si staggered (renewal_type_sub_leg == 1): cohorte de y (current) + cohorte de y-1 (previous)
# - Si full (renewal_type_sub_leg == 2): sólo la cohorte de la última elección ≤ y (marcada como current)
extend_sled_two_cohorts_strict <- function(SLED) {
# chequeo mínimo
req_cols <- c(
"country_name","state_name","chamber_election_sub_leg","year",
"party_name_sub_leg","total_seats_party_sub_leg",
"renewal_type_sub_leg","total_chamber_seats_sub_leg","total_seats_in_contest_sub_leg"
)
miss <- setdiff(req_cols, names(SLED))
if (length(miss)) stop("Faltan columnas en SLED: ", paste(miss, collapse = ", "))
SLED %>%
mutate(
country_name = as.character(country_name),
state_name   = as.character(state_name),
chamber_election_sub_leg = as.integer(chamber_election_sub_leg),
year         = as.integer(year),
party_name_sub_leg = as.character(party_name_sub_leg),
total_seats_party_sub_leg = as.integer(total_seats_party_sub_leg),
renewal_type_sub_leg = as.integer(renewal_type_sub_leg),
total_chamber_seats_sub_leg  = as.integer(total_chamber_seats_sub_leg),
total_seats_in_contest_sub_leg = as.integer(total_seats_in_contest_sub_leg)
) %>%
group_by(country_name, state_name, chamber_election_sub_leg) %>%
group_modify(~{
df <- arrange(.x, year, party_name_sub_leg)
# Secuencia anual continua en el rango observado
yrs <- seq(min(df$year, na.rm = TRUE), max(df$year, na.rm = TRUE))
map_dfr(yrs, function(y) {
# última elección ≤ y (si no hay, no hay foto ese año)
elects_up_to_y <- df %>% filter(year <= y)
if (nrow(elects_up_to_y) == 0) return(NULL)
last_elec_year <- max(elects_up_to_y$year, na.rm = TRUE)
# tipo de renovación de la elección vigente (debería ser constante por año de elección)
rt_vals <- unique(na.omit(df$renewal_type_sub_leg[df$year == last_elec_year]))
rt <- if (length(rt_vals)) rt_vals[1] else NA_integer_
# cohorte actual (la de la última elección ≤ y)
cur <- df %>%
filter(year == last_elec_year) %>%
mutate(seat_origin = "current")
if (rt == 1L) {
# staggered: añadimos cohorte del año y-1 como 'previous' (si existe elección en y-1)
prev <- df %>%
filter(year == (y - 1L)) %>%
mutate(seat_origin = "previous")
bind_rows(cur, prev) %>%
mutate(
year = y,                                 # año de la "foto"
election_year_sub_leg = as.integer(y %in% df$year) # 1 si hubo elección en y
)
} else {
# full renewal (o desconocido): sólo la cohorte vigente
cur %>%
mutate(
year = y,
election_year_sub_leg = as.integer(y %in% df$year)
)
}
})
}) %>%
ungroup()
}
# === USO ===
sled_extended <- extend_sled_two_cohorts_strict(SLED)
extend_sled_two_cohorts_strict <- function(SLED) {
req_cols <- c(
"country_name","state_name","chamber_election_sub_leg","year",
"party_name_sub_leg","total_seats_party_sub_leg",
"renewal_type_sub_leg","total_chamber_seats_sub_leg","total_seats_in_contest_sub_leg"
)
miss <- setdiff(req_cols, names(SLED))
if (length(miss)) stop("Faltan columnas en SLED: ", paste(miss, collapse = ", "))
# helper: inferir renewal type cuando falta
infer_rt <- function(df_year) {
# si viene informado, úsalo (primero no-NA)
rt_u <- unique(na.omit(df_year$renewal_type_sub_leg))
if (length(rt_u)) return(as.integer(rt_u[1]))
# inferir por asientos en contienda vs tamaño de cámara
tc  <- unique(na.omit(df_year$total_chamber_seats_sub_leg))
sc  <- unique(na.omit(df_year$total_seats_in_contest_sub_leg))
if (length(tc) && length(sc)) {
if (any(sc < tc)) return(1L)  # staggered
if (any(sc >= tc)) return(2L) # full
}
2L # por defecto: full (conservador para no duplicar cohortes)
}
SLED %>%
mutate(
country_name = as.character(country_name),
state_name   = as.character(state_name),
chamber_election_sub_leg = as.integer(chamber_election_sub_leg),
year         = as.integer(year),
party_name_sub_leg = as.character(party_name_sub_leg),
total_seats_party_sub_leg = as.integer(total_seats_party_sub_leg),
renewal_type_sub_leg = as.integer(renewal_type_sub_leg),
total_chamber_seats_sub_leg  = as.integer(total_chamber_seats_sub_leg),
total_seats_in_contest_sub_leg = as.integer(total_seats_in_contest_sub_leg)
) %>%
group_by(country_name, state_name, chamber_election_sub_leg) %>%
group_modify(~{
df <- arrange(.x, year, party_name_sub_leg)
yrs <- seq(min(df$year, na.rm = TRUE), max(df$year, na.rm = TRUE))
map_dfr(yrs, function(y) {
elects_up_to_y <- df %>% filter(year <= y)
if (nrow(elects_up_to_y) == 0) return(NULL)
last_elec_year <- max(elects_up_to_y$year, na.rm = TRUE)
# datos de la última elección vigente (para inferir rt si falta)
last_df <- df %>% filter(year == last_elec_year)
rt <- infer_rt(last_df)
cur <- last_df %>% mutate(seat_origin = "current")
if (rt == 1L) {
# staggered: añadimos la cohorte del año y-1 (si existe)
prev <- df %>% filter(year == (y - 1L)) %>% mutate(seat_origin = "previous")
bind_rows(cur, prev) %>%
mutate(
year = y,
election_year_sub_leg = as.integer(y %in% df$year)
)
} else {
# full renewal: solo la cohorte vigente
cur %>%
mutate(
year = y,
election_year_sub_leg = as.integer(y %in% df$year)
)
}
})
}) %>%
ungroup()
}
