breaks <- ci$brks
if(anyDuplicated(breaks)){ ####
ci <- classInt::classIntervals(values, n = length(palette_vector), style = "pretty")
breaks <- ci$brks
}
pal <- colorBin(palette = palette_vector, domain = values, bins = breaks, pretty = T)
