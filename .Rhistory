asignar_colores <- function(df, n_top = 10) {
df <- df %>% arrange(desc(importancia))
n_total <- nrow(df)
n_top_real <- min(n_top, n_total)
n_sec <- n_total - n_top_real
# Colores adaptados al fondo negro
colores_top <- qualitative_hcl(n_top_real, h = seq(15, 375, length.out = n_top_real + 1)[-1],
c = 80, l = 75)
colores_sec <- if (n_sec > 0) {
qualitative_hcl(n_sec, h = seq(15, 375, length.out = n_sec + 1)[-1],
c = 40, l = 85)
} else {
character(0)  # vector vacío si no hay secundarios
}
df$color <- c(colores_top, colores_sec)
return(df)
}
colores_por_pais <- partidos_indexados %>%
group_by(country_name) %>%
group_modify(~ asignar_colores(.x)) %>%
ungroup()
colores_por_pais
library(openxlsx)
library(dplyr)
library(colorspace)
data <- read.xlsx("data/complete_database_edit.xlsx")
# Normalize a variable by group
normalize <- function(x) {
if (length(unique(x)) == 1) return(rep(1, length(x)))
return((x - min(x)) / (max(x) - min(x)))
}
indexed_parties <- data %>%
filter(!is.na(head_party_sub)) %>%
mutate(recent = ifelse(year >= 2000, 1, 0)) %>%
group_by(country_name, head_party_sub) %>%
summarise(
appearances = n(),
appearances_2000 = sum(recent),
votes_winner = sum(votes_candidate_winner, na.rm = TRUE),
.groups = "drop"
) %>%
group_by(country_name) %>%
mutate(
appearances_norm = normalize(appearances),
appearances_2000_norm = normalize(appearances_2000),
votes_winner_norm = normalize(votes_winner),
# Weights: adjust these weights as you see fit
importance = 0.4 * appearances_norm + 0.2 * appearances_2000_norm + 0.4 * votes_winner_norm
) %>%
arrange(country_name, desc(importance)) %>%
ungroup()
indexed_parties %>% View()
assign_colors <- function(df, n_top = 10) {
df <- df %>% arrange(desc(importance))
total <- nrow(df)
top_n <- min(n_top, total)
secondary_n <- total - top_n
# Colors adapted for black background
top_colors <- qualitative_hcl(top_n, h = seq(15, 375, length.out = top_n + 1)[-1],
c = 80, l = 75)
secondary_colors <- if (secondary_n > 0) {
qualitative_hcl(secondary_n, h = seq(15, 375, length.out = secondary_n + 1)[-1],
c = 40, l = 85)
} else {
character(0)  # empty vector if no secondary parties
}
df$color <- c(top_colors, secondary_colors)
return(df)
}
colors_by_country <- indexed_parties %>%
group_by(country_name) %>%
group_modify(~ assign_colors(.x)) %>%
ungroup()
colors_by_country
write.xlsx(colors_by_country,"data/parties_colors.xlsx")
write.xlsx(colors_by_country,"data/party_colors.xlsx")
