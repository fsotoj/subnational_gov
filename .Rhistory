)
) %>%
hc_add_series_list(series_list) %>%
hc_legend(enabled = FALSE) %>%
hc_title(text = "Parliamentary composition over time") %>%
hc_credits(enabled = FALSE)
df <- SLED %>%
filter(
country_name == nameC,
state_name   == nameS
) %>%
transmute(
year  = as.integer(year),
party = as.character(party_name_sub_leg),
seats = as.integer(total_seats_party_sub_leg)
) %>%
group_by(year, party) %>%
summarise(seats = sum(seats, na.rm = TRUE), .groups = "drop") %>%
filter(seats > 0)
years <- sort(unique(df$year))
# -----------------------------
# STACK POSITIONS (CRITICAL)
# -----------------------------
df_stack <- df %>%
group_by(year) %>%
arrange(seats, .by_group = TRUE) %>%
mutate(
y0 = cumsum(seats) - seats,
y1 = cumsum(seats)
) %>%
ungroup()
# -----------------------------
# PALETTE
# -----------------------------
pal <- palette_from_table(
parties     = unique(df_stack$party),
color_table = party_colors_leg,
party_col   = "party_name_sub_leg",
color_col   = "color",
default     = "#888888"
)
# -----------------------------
# BUILD SERIES
# -----------------------------
hc <- highchart() %>%
hc_chart(type = "column", animation = FALSE) %>%
hc_xAxis(categories = years) %>%
hc_yAxis(title = list(text = "Seats")) %>%
hc_legend(enabled = FALSE)
# 1) Stacked columns (bars)
for (p in unique(df_stack$party)) {
data_p <- df_stack %>%
filter(party == p) %>%
arrange(year)
hc <- hc %>%
hc_add_series(
name = p,
type = "column",
stacking = "normal",
data = data_p$seats,
color = pal[[p]] %||% "#888888",
borderWidth = 0
)
}
# 2) Connectors (arearange)
for (p in unique(df_stack$party)) {
dp <- df_stack %>% filter(party == p)
if (nrow(dp) < 2) next
for (i in seq_len(nrow(dp) - 1)) {
hc <- hc %>%
hc_add_series(
type = "arearange",
showInLegend = FALSE,
enableMouseTracking = FALSE,
color = pal[[p]] %||% "#888888",
fillOpacity = 0.6,
data = list(
list(
x = which(years == dp$year[i]),
low = dp$y0[i],
high = dp$y1[i]
),
list(
x = which(years == dp$year[i + 1]),
low = dp$y0[i + 1],
high = dp$y1[i + 1]
)
)
)
}
}
hc
df_mvp <- SLED %>%
filter(
country_name == nameC,
state_name   == nameS
) %>%
transmute(
year  = as.character(year),
party = as.character(party_name_sub_leg),
seats = as.integer(total_seats_party_sub_leg)
) %>%
group_by(year, party) %>%
summarise(seats = sum(seats, na.rm = TRUE), .groups = "drop") %>%
filter(seats > 0)
# -----------------------------
# COMPLETE YEARS × PARTIES
# -----------------------------
years <- sort(unique(df_mvp$year))
df_wide <- df_mvp %>%
complete(year = years, party, fill = list(seats = 0)) %>%
pivot_wider(
names_from  = year,
values_from = seats
)
# -----------------------------
# PARTY PALETTE (your function)
# -----------------------------
pal <- palette_from_table(
parties     = df_wide$party,
color_table = party_colors_leg,
party_col   = "party_name_sub_leg",
color_col   = "color",
default     = "#888888"
)
# -----------------------------
# BUILD HIGHCHARTS SERIES
# -----------------------------
series_list <- lapply(seq_len(nrow(df_wide)), function(i) {
party <- df_wide$party[i]
list(
name  = party,
data  = as.numeric(df_wide[i, -1]),
color = pal[[party]] %||% "#888888"
)
})
# -----------------------------
# PLOT: ALLUVIAL-STYLE STACKED AREA
# -----------------------------
highchart() %>%
hc_chart(type = "area", animation = FALSE) %>%
hc_xAxis(
categories = years,
tickmarkPlacement = "on",
title = list(text = NULL)
) %>%
hc_yAxis(
title = list(text = "Seats")
) %>%
hc_plotOptions(
area = list(
stacking = "normal",
lineWidth = 0.5,
marker = list(enabled = FALSE)
),
series = list(animation = FALSE)
) %>%
hc_add_series_list(series_list) %>%
hc_legend(enabled = FALSE) %>%   # IMPORTANT with many parties
hc_title(text = "Parliamentary composition over time") %>%
hc_credits(enabled = FALSE)
library(dplyr)
library(echarts4r)
df_mvp <- SLED %>%
filter(
country_name == nameC,
state_name   == nameS
) %>%
transmute(
year  = as.character(year),
party = as.character(party_name_sub_leg),
seats = as.integer(total_seats_party_sub_leg)
) %>%
group_by(year, party) %>%
summarise(seats = sum(seats, na.rm = TRUE), .groups = "drop") %>%
filter(seats > 0)
# -----------------------------
# BUILD NODES (year | party)
# -----------------------------
nodes <- df_mvp %>%
mutate(name = paste(year, party, sep = " | ")) %>%
distinct(name)
# -----------------------------
# BUILD LINKS (party continuity)
# -----------------------------
years <- sort(unique(df_mvp$year))
links <- purrr::map_dfr(seq_along(years)[-length(years)], function(i) {
y1 <- years[i]
y2 <- years[i + 1]
df1 <- df_mvp %>% filter(year == y1)
df2 <- df_mvp %>% filter(year == y2)
inner_join(df1, df2, by = "party", suffix = c("_from", "_to")) %>%
transmute(
source = paste(year_from, party, sep = " | "),
target = paste(year_to,   party, sep = " | "),
value  = pmin(seats_from, seats_to)   # continuity only
)
})
# -----------------------------
# PARTY COLORS (optional)
# -----------------------------
pal <- palette_from_table(
parties     = unique(df_mvp$party),
color_table = party_colors_leg,
party_col   = "party_name_sub_leg",
color_col   = "color",
default     = "#888888"
)
nodes <- nodes %>%
mutate(
party = sub("^.* \\| ", "", name),
itemStyle = purrr::map(
party,
~ list(color = pal[[.x]] %||% "#888888")
)
) %>%
select(-party)
# -----------------------------
# ALLUVIAL (SANKEY) CHART
# -----------------------------
echarts4r::e_charts() %>%
e_sankey(
nodes = nodes,
links = links,
emphasis = list(focus = "adjacency"),
lineStyle = list(
color = "source",
curveness = 0.5,
opacity = 0.6
),
nodeAlign = "justify"
) %>%
e_title("Parliamentary composition over time") %>%
e_tooltip(trigger = "item") %>%
e_legend(show = FALSE)
