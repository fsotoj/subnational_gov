library(openxlsx)
data <- read.xlsx("data/complete_database_edit.xlsx")
data %>%
select(country_name,country_code,state_name,state_code) %>%
unique() %>%
arrange(country_name,state_name)
)
data %>%
select(country_name,country_code,state_name,state_code) %>%
unique() %>%
arrange(country_name,state_name) %>%
mutate(state_old_name = case_when(
state_name == "MATO GROSSO DO SUL" ~ "MATO GROSS DO SUL",
state_name == "COAHUILA DE ZARAGOZA" ~ "COAHUILA",
state_name == "MICHOACAN DE OCAMPO" ~ "MICHOACAN",
state_name == "QUERETARO DE ARTEAGA" ~ "QUERETARO",
state_name == "VERACRUZ DE IGNACIO DE LA LLAVE" ~ "VERACRUZ",
))
