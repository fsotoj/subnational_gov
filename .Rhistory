library(echarts4r)
library(purrr)
library(echarts4r)
# -----------------------------
# FILTER DATA (example)
# -----------------------------
nameC <- "BRAZIL"
nameS <- "ACRE"
df_mvp <- SLED %>%
filter(
country_name == nameC,
state_name   == nameS
) %>%
transmute(
year  = as.character(year),
party = as.character(party_name_sub_leg),
seats = as.integer(total_seats_party_sub_leg)
) %>%
group_by(year, party) %>%
summarise(seats = sum(seats, na.rm = TRUE), .groups = "drop") %>%
filter(seats > 0)
# -----------------------------
# YEARS
# -----------------------------
years <- sort(unique(df_mvp$year))
stopifnot(length(years) >= 2)
# -----------------------------
# NODES: one per (year | party)
# -----------------------------
nodes <- df_mvp %>%
mutate(name = paste(year, party, sep = " | ")) %>%
distinct(name)
# -----------------------------
# LINKS: party continuity only
# -----------------------------
links <- map_dfr(seq_len(length(years) - 1), function(i) {
y_from <- years[i]
y_to   <- years[i + 1]
df_from <- df_mvp %>% filter(year == y_from)
df_to   <- df_mvp %>% filter(year == y_to)
inner_join(df_from, df_to, by = "party", suffix = c("_from", "_to")) %>%
transmute(
source = paste(year_from, party, sep = " | "),
target = paste(year_to,   party, sep = " | "),
value  = pmin(seats_from, seats_to)
)
}) %>%
filter(!is.na(source), !is.na(target), value > 0)
# -----------------------------
# HARD GUARD (prevents your error)
# -----------------------------
stopifnot(nrow(links) > 0)
# -----------------------------
# PARTY COLORS (your palette)
# -----------------------------
pal <- palette_from_table(
parties     = unique(df_mvp$party),
color_table = party_colors_leg,
party_col   = "party_name_sub_leg",
color_col   = "color",
default     = "#888888"
)
nodes <- nodes %>%
mutate(
party = sub("^.* \\| ", "", name),
itemStyle = map(
party,
~ list(color = pal[[.x]] %||% "#888888")
)
) %>%
select(-party)
# -----------------------------
# ALLUVIAL (SANKEY) CHART
# -----------------------------
e_charts() %>%
e_sankey(
nodes = nodes,
links = links,
nodeAlign = "justify",
emphasis = list(focus = "adjacency"),
lineStyle = list(
color = "source",
curveness = 0.5,
opacity = 0.6
)
) %>%
e_title("Parliamentary composition over time") %>%
e_tooltip(trigger = "item") %>%
e_legend(show = FALSE)
# -----------------------------
# FILTER DATA
# -----------------------------
df_mvp <- SLED %>%
filter(
country_name == nameC,
state_name   == nameS,
chamber_election_sub_leg == 1
) %>%
transmute(
year  = as.character(year),
party = as.character(party_name_sub_leg),
seats = as.integer(total_seats_party_sub_leg)
) %>%
group_by(year, party) %>%
summarise(seats = sum(seats, na.rm = TRUE), .groups = "drop") %>%
filter(seats > 0)
years <- sort(unique(df_mvp$year))
stopifnot(length(years) >= 2)
# -----------------------------
# NODES: every (year | party)
# -----------------------------
nodes <- df_mvp %>%
mutate(name = paste(year, party, sep = " | ")) %>%
distinct(name)
# -----------------------------
# LINKS: identity-only, GUARANTEED
# -----------------------------
links <- df_mvp %>%
arrange(party, year) %>%
group_by(party) %>%
mutate(
next_year  = lead(year),
next_seats = lead(seats)
) %>%
filter(!is.na(next_year)) %>%
transmute(
source = paste(year, party, sep = " | "),
target = paste(next_year, party, sep = " | "),
value  = seats          # <-- CRITICAL: always positive
)
stopifnot(nrow(links) > 0)
# -----------------------------
# SANKEY / ALLUVIAL
# -----------------------------
e_charts() %>%
e_sankey(
nodes = nodes,
links = links,
nodeAlign = "justify",
emphasis = list(focus = "adjacency"),
lineStyle = list(
color = "source",
curveness = 0.5,
opacity = 0.6
)
) %>%
e_title("Parliamentary composition over time") %>%
e_tooltip(trigger = "item") %>%
e_legend(show = FALSE)
df_mvp <- SLED %>%
filter(
country_name == "BRAZIL",
state_name   == "ACRE",
chamber_election_sub_leg == 1,
) %>%
transmute(
year  = factor(year),                 # MUST be factor
party = as.character(party_name_sub_leg),
seats = as.integer(total_seats_party_sub_leg)
) %>%
group_by(year, party) %>%
summarise(seats = sum(seats, na.rm = TRUE), .groups = "drop") %>%
filter(seats > 0)
pal <- palette_from_table(
parties     = unique(df_mvp$party),
color_table = party_colors_leg,
party_col   = "party_name_sub_leg",
color_col   = "color",
default     = "#888888"
)
ggplot(
df_mvp,
aes(
x        = year,
stratum  = party,
alluvium = party,
y        = seats,
fill     = party
)
) +
geom_flow(
alpha = 0.9,
width = 0.7
) +
geom_stratum(
width = 0.7,
color = "white",
linewidth = 0.25
) +
scale_fill_manual(values = pal) +
theme_minimal() +
labs(
x = NULL,
y = "Seats",
fill = "Party",
title = "Parliamentary composition over time"
) +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor   = element_blank()
)+ theme(legend.position = "none")
