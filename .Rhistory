assign_colors <- function(df, n_top = 10) {
df <- df %>% arrange(desc(importance))
total <- nrow(df)
top_n <- min(n_top, total)
secondary_n <- total - top_n
# Top colors: Set3 (hasta 12 colores)
top_colors <- if (top_n <= 12) {
brewer.pal(top_n, "Set3")
} else {
rep(brewer.pal(12, "Set3"), length.out = top_n)
}
# Secondary colors: glasbey_vector (más de 40 colores disponibles)
# paletteer_d_names("glasbey") para ver nombres, acá usamos "glasbey_vector"
secondary_colors <- if (secondary_n > 0) {
glasbey_pal <- paletteer_d("ggsci::default_igv", n = secondary_n)
glasbey_pal
} else {
character(0)
}
df$color <- c(top_colors, secondary_colors)
return(df)
}
