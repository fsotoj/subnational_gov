.groups = "drop"
) %>%
arrange(country_name, desc(n), desc(votos))
partidos_jerarquizados
library(RColorBrewer)
asignar_colores <- function(df) {
n_colores <- 10
partidos_top <- df %>% head(n_colores)
colores <- brewer.pal(min(n_colores, nrow(partidos_top)), "Set3")
partidos_top$color <- colores
# Asignar gris a los demás
if (nrow(df) > n_colores) {
partidos_otros <- df %>% slice((n_colores + 1):n())
partidos_otros$color <- "#CCCCCC"
df <- bind_rows(partidos_top, partidos_otros)
} else {
df <- partidos_top
}
return(df)
}
